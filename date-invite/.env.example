# Copy this file to `.env.local` and fill in what you need.
# Everything here is OPTIONAL. The site works without any of it.
# Never commit your real .env.local file.

# --- RSVP notifications -------------------------------------------------
# The email address the "send it to her" fallback (mailto) is addressed to.
# Defaults to ogungburemayowa2019@gmail.com (set in src/lib/rsvpService.ts).
VITE_RSVP_EMAIL=

# EmailJS (https://www.emailjs.com) — fill all three to send RSVPs automatically.
# These are PUBLIC browser keys by EmailJS design; never put a private key here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Background music ---------------------------------------------------
# Optional URL to an mp3 (e.g. /music.mp3 placed in /public).
# If empty, the site plays a soft generated ambient tune instead.
VITE_MUSIC_URL=
